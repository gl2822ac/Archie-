\outl0\strokewidth0 \strokec2 :root\{\
  --paper:#fbfaf8;\
  --ink:#131613;\
\
  /* pulled from your invite / photos */\
  --forest:#2c5a2b;\
  --mist:#a9c1c9;\
  --warm:#e9b95c;\
  --rose:#d26d7b;\
\
  --border: rgba(19,22,19,.14);\
  --shadow: 0 18px 55px rgba(0,0,0,.12);\
  --radius: 22px;\
\
  --hand: "Permanent Marker", cursive;\
  --body: "Inter", system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif;\
\
  --max:1100px;\
\}\
\
/* RESET */\
*\{ box-sizing:border-box; \}\
html\{ scroll-behavior:smooth; \}\
body\{\
  margin:0;\
  font-family:var(--body);\
  color:var(--ink);\
  background:var(--paper);\
  line-height:1.6;\
\}\
img\{ display:block; max-width:100%; \}\
a\{ color:inherit; text-decoration:none; \}\
\
.container\{\
  width:min(var(--max), calc(100% - 40px));\
  margin:0 auto;\
\}\
\
/* TOP NAV */\
.top\{\
  position:sticky;\
  top:0;\
  z-index:50;\
  display:flex;\
  justify-content:space-between;\
  align-items:center;\
  padding:12px 18px;\
  background:rgba(251,250,248,.85);\
  backdrop-filter:blur(10px);\
  border-bottom:1px solid rgba(0,0,0,.05);\
\}\
\
.monogram\{\
  font-family:var(--hand);\
  font-size:24px;\
\}\
.monogram span\{ color:var(--forest); \}\
\
.nav\{\
  display:flex;\
  gap:16px;\
  align-items:center;\
\}\
.nav a\{\
  padding:8px 10px;\
  border-radius:999px;\
\}\
.nav a:hover\{\
  background:rgba(44,90,43,.08);\
\}\
.nav__cta\{\
  border:1px solid var(--border);\
  background:#fff;\
\}\
\
/* HERO */\
.hero\{\
  position:relative;\
  min-height:75vh;\
  display:grid;\
  place-items:center;\
  text-align:center;\
  overflow:hidden;\
\}\
.hero__media\{\
  position:absolute;\
  inset:0;\
\}\
.hero__media img\{\
  width:100%;\
  height:100%;\
  object-fit:cover;\
  transform:scale(1.05);\
\}\
.hero__fade\{\
  position:absolute;\
  inset:0;\
  background:\
    radial-gradient(800px 400px at 20% 10%, rgba(233,185,92,.2), transparent 60%),\
    linear-gradient(180deg, rgba(0,0,0,.55), rgba(0,0,0,.45));\
\}\
.hero__content\{\
  position:relative;\
  color:#fff;\
  padding:40px 20px;\
  max-width:900px;\
\}\
.hero__eyebrow\{\
  text-transform:uppercase;\
  letter-spacing:.2em;\
  font-size:12px;\
  opacity:.9;\
\}\
.hero__title\{\
  margin:10px 0;\
  font-family:var(--hand);\
  font-size:clamp(60px, 7vw, 100px);\
  line-height:.95;\
  transform:rotate(-1deg);\
  text-shadow:\
    0 2px 4px rgba(0,0,0,.4),\
    0 6px 18px rgba(0,0,0,.4);\
\}\
.hero__title .amp\{\
  color:var(--warm);\
  transform:rotate(4deg);\
  display:inline-block;\
\}\
.hero__sub\{\
  font-size:16px;\
  margin:8px 0;\
\}\
.hero__place\{\
  font-size:14px;\
  opacity:.9;\
\}\
\
/* BUTTONS */\
.btn\{\
  display:inline-flex;\
  align-items:center;\
  justify-content:center;\
  padding:12px 18px;\
  border-radius:999px;\
  font-weight:600;\
  border:1px solid rgba(255,255,255,.2);\
  background:linear-gradient(180deg, rgba(233,185,92,.95), rgba(233,185,92,.8));\
  color:#1b1b14;\
  box-shadow:0 12px 30px rgba(0,0,0,.25);\
  transition:.2s ease;\
\}\
.btn:hover\{\
  transform:translateY(-2px);\
\}\
.btn--ghost\{\
  background:rgba(255,255,255,.15);\
  color:#fff;\
  box-shadow:none;\
\}\
.btn--big\{\
  padding:14px 22px;\
  font-size:16px;\
\}\
\
/* SECTION BASE */\
.section\{\
  padding:70px 0;\
\}\
.section--alt\{\
  background:linear-gradient(180deg, rgba(169,193,201,.12), rgba(251,250,248,0));\
  border-top:1px solid rgba(0,0,0,.05);\
  border-bottom:1px solid rgba(0,0,0,.05);\
\}\
\
/* PAPER STYLE INFO SECTION */\
.paper\{\
  width:min(var(--max), calc(100% - 40px));\
  margin:0 auto;\
  padding:30px 20px;\
  background:rgba(255,255,255,.8);\
  border-radius:28px;\
  box-shadow:var(--shadow);\
  position:relative;\
  overflow:hidden;\
\}\
\
/* watercolor accent blobs */\
.paper::before\{\
  content:"";\
  position:absolute;\
  top:-80px;\
  left:-120px;\
  width:400px;\
  height:300px;\
  background:radial-gradient(circle at 40% 40%, rgba(233,185,92,.6), transparent 70%);\
  filter:blur(40px);\
\}\
.paper::after\{\
  content:"";\
  position:absolute;\
  bottom:-120px;\
  right:-140px;\
  width:450px;\
  height:350px;\
  background:radial-gradient(circle at 50% 50%, rgba(210,109,123,.5), transparent 70%);\
  filter:blur(50px);\
\}\
\
.heading\{\
  font-family:var(--hand);\
  font-size:56px;\
  text-align:center;\
  margin-bottom:30px;\
\}\
\
/* INFO BLOCKS */\
.flow\{\
  display:grid;\
  gap:20px;\
  grid-template-columns:repeat(12, 1fr);\
\}\
.block\{\
  grid-column:span 6;\
  padding:18px;\
  background:rgba(251,250,248,.8);\
  border:1px dashed rgba(0,0,0,.15);\
  border-radius:18px;\
  transform:rotate(-.5deg);\
\}\
.block:nth-child(even)\{\
  transform:rotate(.5deg);\
\}\
.block__title\{\
  font-family:var(--hand);\
  font-size:28px;\
  margin-bottom:8px;\
\}\
.schedule\{\
  list-style:none;\
  padding:0;\
  margin:0;\
\}\
.schedule li\{\
  margin:6px 0;\
\}\
\
/* GALLERY */\
.masonry\{\
  width:min(var(--max), calc(100% - 40px));\
  margin:0 auto;\
  display:grid;\
  gap:16px;\
  grid-template-columns:repeat(12, 1fr);\
\}\
.shot\{\
  grid-column:span 6;\
  border-radius:20px;\
  overflow:hidden;\
  box-shadow:var(--shadow);\
  cursor:pointer;\
\}\
.shot--wide\{\
  grid-column:span 12;\
\}\
.shot img\{\
  width:100%;\
  height:320px;\
  object-fit:cover;\
  transition:.3s ease;\
\}\
.shot:hover img\{\
  transform:scale(1.05);\
\}\
\
/* RSVP */\
.rsvp\{\
  width:min(700px, calc(100% - 40px));\
  margin:0 auto;\
  text-align:center;\
  padding:30px;\
  background:rgba(255,255,255,.85);\
  border-radius:30px;\
  box-shadow:var(--shadow);\
\}\
\
/* FOOTER */\
.footer\{\
  padding:30px 0;\
  text-align:center;\
  font-size:14px;\
  opacity:.7;\
\}\
\
/* MOBILE */\
@media (max-width:900px)\{\
  .block\{ grid-column:span 12; \}\
  .shot\{ grid-column:span 12; \}\
  .hero__title\{ font-size:58px; \}\
\}}