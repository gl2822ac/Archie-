\f0\fs24 \cf0 // --- Simple lightbox for gallery images ---\
\
// Create lightbox elements\
const lightbox = document.createElement("div");\
lightbox.className = "lightbox";\
lightbox.hidden = true;\
\
const closeBtn = document.createElement("button");\
closeBtn.className = "lightbox__close";\
closeBtn.setAttribute("aria-label", "Close image");\
closeBtn.textContent = "\uc0\u10005 ";\
\
const img = document.createElement("img");\
img.className = "lightbox__img";\
img.alt = "Expanded photo";\
\
lightbox.appendChild(closeBtn);\
lightbox.appendChild(img);\
document.body.appendChild(lightbox);\
\
// Open lightbox when clicking any gallery button\
document.querySelectorAll("[data-full]").forEach((btn) => \{\
  btn.addEventListener("click", () => \{\
    const src = btn.getAttribute("data-full");\
    img.src = src;\
    lightbox.hidden = false;\
  \});\
\});\
\
// Close logic\
function closeLightbox() \{\
  lightbox.hidden = true;\
  img.src = "";\
\}\
\
closeBtn.addEventListener("click", closeLightbox);\
\
// Click outside the image closes it\
lightbox.addEventListener("click", (e) => \{\
  if (e.target === lightbox) closeLightbox();\
\});\
\
// Escape key closes it\
document.addEventListener("keydown", (e) => \{\
  if (!lightbox.hidden && e.key === "Escape") closeLightbox();\
\});}